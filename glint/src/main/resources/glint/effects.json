    {"id": "plague",    "name": "Plague",          "class": "enchant",  "when": {"all": ["poison", "curse"]},   "look": {"shape": "ring", "y": 0.3, "p": "noxious_gas", "rate": 0.5, "extra": [{"p": "squid_ink", "share": 0.3}]}},
    {"id": "zephyr",    "name": "Zephyr",          "class": "enchant",  "when": {"all": ["feather", "wind"]},   "look": {"shape": "spiral", "y0": 0.2, "y1": 1.0, "p": "small_gust", "extra": [{"p": "white_ash", "share": 0.5}]}},
    {"id": "ocean",     "name": "Ocean",           "class": "enchant",  "when": {"all": ["water"], "any": ["tide", "loyalty", "impale"]}, "look": {"shape": "spiral", "p": "nautilus", "extra": [{"p": "splash", "share": 0.3}]}},
    {"id": "bloodthorn","name": "Bloodthorn",      "class": "enchant",  "when": {"all": ["thorns", "sharp"]},   "look": {"shape": "ring", "y": 1.2, "p": "dust", "color": "#9E0F1A", "extra": [{"p": "crit", "share": 0.4}]}},
    {"id": "arcane",    "name": "Arcane",          "class": "enchant",  "when": {"all": ["power", "infinity"]}, "look": {"shape": "spiral", "p": "enchant", "motion": "approach", "extra": [{"p": "witch", "share": 0.5}]}},
    {"id": "prospector","name": "Prospector",      "class": "enchant",  "when": {"all": ["luck", "haste"]},     "look": {"shape": "anchor", "p": "happy_villager", "extra": [{"p": "wax_off", "share": 0.5}]}}
  ],

  "comboRules": {
    "order": "the first combination in the list that matches, per class",
    "classes": ["legend", "material", "trim", "enchant"],
    "atOnce": {"legend": 1, "material": 1, "trim": 1, "enchant": 1, "total": 2},
    "replaces": "a combination replaces the idle look of what it is made of (those families, that material set or trim set); everything else stays",
    "events": "a combination keeps the events of its parts (a Steam sword still swings flames)"
  },

  "events": {
    "swing":      "attacking with the item in your hand",
    "hit":        "your attack lands",
    "kill":       "you defeat something",
    "smash":      "a mace smash attack",
    "shoot":      "an arrow, trident or firework you fire: a trail behind it",
    "riptide":    "riptide launches you",
    "hurt":       "you are hurt (thorns towards the attacker, protection absorbs)",
    "burning":    "you are on fire",
    "fall":       "falling more than 3 blocks",
    "land":       "landing after a fall",
    "step":       "each step while walking",
    "sneak":      "while sneaking",
    "underwater": "while under water",
    "gliding":    "while flying with an elytra",
    "break":      "breaking a block with the tool",
    "repair":     "experience repairs the item (Mending)",
    "catch":      "catching something with the fishing rod"
  }
}
