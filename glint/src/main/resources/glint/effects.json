    {"id": "endergaze", "name": "Ender Gaze",      "class": "trim",     "when": {"anyOf": [{"trimPattern": {"eye": 1}}, {"trimPattern": {"spire": 1}}], "any": ["infinity", "loyalty"]},
     "look": {"shape": "burst", "y": 1.7, "p": "portal", "inward": true, "extra": [{"p": "witch", "share": 0.3}]}},
