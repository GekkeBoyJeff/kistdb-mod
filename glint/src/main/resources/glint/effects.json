    "copper":    {"name": "Copper",    "color": "#E77C56", "character": {"speed": 1.0, "size": 1.0},
                  "set": {"name": "Patina", "shape": "ring", "y": 0.9, "p": "dust_color_transition", "color": "#E77C56", "to": "#5FBF9F", "rate": 0.8}},
    "iron":      {"name": "Iron",      "color": "#D8D8D8", "character": {"speed": 1.0, "size": 1.0},
                  "set": {"name": "Steel", "shape": "ring", "y": 1.2, "p": "wax_off", "rate": 0.5}},
    "gold":      {"name": "Gold",      "color": "#FDE45F", "character": {"speed": 1.1, "size": 1.0, "sparkle": "happy_villager"},
                  "set": {"name": "Gilded", "shape": "ring", "y": 1.2, "p": "dust", "color": "#FDE45F", "rate": 1.0}},
    "diamond":   {"name": "Diamond",   "color": "#4AEDD9", "character": {"speed": 1.0, "size": 1.0, "sparkle": "end_rod"},
                  "set": {"name": "Crystal", "shape": "ring", "y": 1.4, "p": "end_rod", "rate": 0.5}},
    "netherite": {"name": "Netherite", "color": "#5A4E50", "accent": "#FF6A2A", "character": {"speed": 0.7, "size": 1.1},
                  "set": {"name": "Forged", "shape": "ring", "y": 2.1, "p": "white_ash", "motion": "fall", "rate": 1.0, "extra": {"p": "lava", "share": 0.1}}},
    "turtle_scute": {"name": "Turtle shell", "color": "#47BF4A", "character": {"speed": 0.9, "size": 1.0}},
    "elytra":    {"name": "Elytra", "color": "#8E8EB5", "character": {"speed": 1.0, "size": 1.0},
                  "gliding": {"shape": "wingtips", "p": "trail"}}
  },

  "trimMaterials": {
    "quartz":    {"color": "#E9DFD3", "sparkle": {"p": "dust", "color": "#FFFFFF"}},
    "iron":      {"color": "#ECECEC", "sparkle": {"p": "wax_off"}},
    "netherite": {"color": "#625859", "sparkle": {"p": "dust", "color": "#FF6A2A"}},
    "redstone":  {"color": "#BD2008", "sparkle": {"p": "dust", "color": "#FF1A1A"}},
    "copper":    {"color": "#B4684D", "sparkle": {"p": "wax_on"}},
    "gold":      {"color": "#DEB12D", "sparkle": {"p": "dust", "color": "#FFE36B"}},
