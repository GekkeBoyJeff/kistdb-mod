    "resin":     {"color": "#D9641E", "sparkle": {"p": "falling_honey"}}
  },

  "trimPatterns": {
    "sentry":    {"from": "Pillager Outpost",  "shape": "sentinels", "set": {"name": "Watch",          "shape": "sentinels", "y": 1.2, "p": "dust"}},
    "dune":      {"from": "Desert Pyramid",    "shape": "ring", "motion": "sway",  "set": {"name": "Sandstorm",   "shape": "spiral", "p": "falling_dust", "block": "sand"}},
    "coast":     {"from": "Shipwreck",         "shape": "pulse", "motion": "float", "set": {"name": "Shoreline", "shape": "ring", "y": 0.3, "p": "splash"}},
    "wild":      {"from": "Jungle Temple",     "shape": "spiral", "motion": "rise", "set": {"name": "Overgrowth",  "shape": "ring", "p": "tinted_leaves", "motion": "sway"}},
    "ward":      {"from": "Ancient City",      "shape": "ring", "full": true,      "set": {"name": "Ward",        "shape": "ring", "y": 0.24, "p": "dust", "full": true, "also": {"y": 2.02}}},
    "eye":       {"from": "Stronghold",        "shape": "ring", "motion": "approach", "set": {"name": "Gaze",     "shape": "burst", "y": 1.7, "p": "portal", "inward": true}},
    "vex":       {"from": "Woodland Mansion",  "shape": "zigzag", "motion": "tangent", "set": {"name": "Haunt",   "shape": "trail", "p": "trail", "n": 3, "circle": 2.0}},
    "tide":      {"from": "Ocean Monument",    "shape": "spiral", "motion": "sway", "set": {"name": "Current",    "shape": "helix", "p": "dolphin"}},
    "snout":     {"from": "Bastion Remnant",   "shape": "ring", "motion": "pop",   "set": {"name": "Hoard",       "shape": "ring", "y": 0.6, "p": "dust", "color": "#FFD23A", "motion": "pop"}},
    "rib":       {"from": "Nether Fortress",   "shape": "ribs", "motion": "rise",  "set": {"name": "Ribcage",     "shape": "ribs", "p": "dust", "color": "#EDE6D6"}},
    "spire":     {"from": "End City",          "shape": "column", "motion": "rise", "set": {"name": "Spire",      "shape": "column", "y0": 1.9, "y1": 3.0, "p": "end_rod"}},
    "wayfinder": {"from": "Trail Ruins",       "shape": "ring", "front": true,     "set": {"name": "Pathfinder",  "shape": "footprint", "p": "dust", "when": "walking"}},
    "raiser":    {"from": "Trail Ruins",       "shape": "column", "motion": "rise", "set": {"name": "Ascent",     "shape": "spiral", "p": "dust"}},
    "shaper":    {"from": "Trail Ruins",       "shape": "square",                  "set": {"name": "Blueprint",   "shape": "square", "y": 0.24, "p": "dust"}},
    "host":      {"from": "Trail Ruins",       "shape": "pulse",                   "set": {"name": "Heartbeat",   "shape": "pulse", "y": 1.2, "p": "dust"}},
    "silence":   {"from": "Ancient City",      "shape": "ring", "rate": 0.5, "hush": 0.5, "set": {"name": "Silent shroud", "shape": "helix", "p": "sculk_soul", "extra": {"p": "dust", "color": "#0F2A33"}}},
    "flow":      {"from": "Trial Chambers",    "shape": "ring", "motion": "tangent", "set": {"name": "Breeze",    "shape": "spiral", "p": "small_gust"}},
    "bolt":      {"from": "Trial Chambers",    "shape": "zigzag",                  "set": {"name": "Charge",      "shape": "zigzag", "p": "electric_spark"}}
  },

  "items": {
    "sword":       {"anchor": "blade",  "swing": "arc"},
    "axe":         {"anchor": "head",   "swing": "arc"},
    "spear":       {"anchor": "tip",    "swing": "thrust"},
    "mace":        {"anchor": "head",   "swing": "arc", "smash": true},
    "trident":     {"anchor": "tip",    "swing": "thrust", "throw": true},
    "pickaxe":     {"anchor": "head"},
    "shovel":      {"anchor": "head"},
    "hoe":         {"anchor": "head"},
    "bow":         {"anchor": "string", "shoot": true},
