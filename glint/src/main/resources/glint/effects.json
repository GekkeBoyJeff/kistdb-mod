    {"id": "blizzard",  "name": "Blizzard",        "class": "enchant",  "when": {"all": ["frost", "water"]},    "look": {"shape": "ring", "motion": "tangent", "p": "snowflake", "n": 2}},
    {"id": "storm",     "name": "Storm",           "class": "enchant",  "when": {"all": ["lightning", "water"]},"look": {"shape": "cloud", "y": 2.35, "p": "cloud", "extra": [{"p": "dripping_water", "share": 0.6}, {"p": "electric_spark", "share": 0.2}, {"p": "flash", "share": 0.02}]}},
    {"id": "plasma",    "name": "Plasma",          "class": "enchant",  "when": {"all": ["lightning", "fire"]}, "look": {"shape": "ring", "y": 1.2, "motion": "tangent", "p": "electric_spark", "n": 3, "extra": [{"p": "small_flame", "share": 0.4}]}},
    {"id": "deepdark",  "name": "Deep Dark",       "class": "enchant",  "when": {"all": ["sculk", "soul"]},    "look": {"shape": "ring", "y": 0.24, "p": "sculk_soul", "motion": "rise", "extra": [{"p": "soul", "share": 0.3}]}},
