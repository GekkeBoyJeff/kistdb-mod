    "other":       {"anchor": "hand"}
  },

  "combos": [
    {"id": "paragon",   "name": "Paragon",         "class": "legend",   "when": {"maxedPieces": 4, "sameMaterial": 4, "sameTrimPattern": 4},
     "look": {"shape": "helix", "p": "end_rod", "extra": [{"shape": "ring", "y": 2.02, "p": "dust", "color": "trim"}, {"shape": "ring", "y": 0.24, "p": "dust", "color": "trim"}]}},
    {"id": "infernal",  "name": "Infernal",        "class": "material", "when": {"material": {"netherite": 2}, "any": ["fire", "fireguard"]},
