    {"id": "crystalward","name": "Crystal Ward",   "class": "material", "when": {"material": {"diamond": 4}, "all": [{"family": "protection", "pieces": 4, "tier": "max"}]},
     "look": {"shape": "ring", "y": 1.2, "p": "enchant", "motion": "approach", "extra": [{"shape": "ring", "y": 1.2, "p": "end_rod"}]}},
    {"id": "warden",    "name": "Warden's Shadow", "class": "trim",     "when": {"trimPattern": {"silence": 1}, "any": ["sculk"]},
     "look": {"shape": "ribs", "p": "sculk_soul", "extra": [{"p": "dust", "color": "#0F2A33"}, {"p": "shriek", "share": 0.03}]}},
    {"id": "abyssal",   "name": "Abyssal",         "class": "trim",     "when": {"anyOf": [{"trimPattern": {"tide": 1}}, {"trimPattern": {"coast": 1}}, {"material": {"turtle_scute": 1}}], "any": ["water", "tide"]},
     "look": {"shape": "spiral", "p": "nautilus", "extra": [{"p": "bubble_pop", "share": 0.4}]}},
    {"id": "bloom",     "name": "Bloom",           "class": "trim",     "when": {"trimPattern": {"wild": 1}, "any": ["silk", "luck"]},
