{
  "version": 1,
  "about": "The single source of truth for enchant effects. Read by GlintMod (Java) and by the web mock. Rules: glint/EFFECTS.md.",

  "budget": {
    "runTicks": 5,
    "pointsPerRun": {"subtle": 2, "normal": 3, "rich": 5},
    "maxCount": 3,
    "eventCooldownTicks": {"swing": 6, "hit": 10, "land": 20, "step": 0, "kill": 0, "shoot": 0, "break": 4, "repair": 20, "catch": 0},
    "priority": ["combo", "hand", "set", "trimSet", "materialSet", "zones", "accents", "sparkle"]
  },

  "zones": {
    "head":  {"y": 2.02, "r": 0.32, "shape": "ring", "label": "halo above the head"},
    "chest": {"y": 1.20, "r": 0.55, "shape": "ring", "label": "orbit at the chest"},
    "legs":  {"y": 0.72, "r": 0.48, "shape": "ring", "label": "swirl at the hips"},
    "feet":  {"y": 0.24, "r": 0.40, "shape": "ring", "label": "ring at the ankles (never on the ground)"},
    "hand":  {"shape": "anchor", "label": "along the held item"},
    "offhand": {"shape": "anchor", "label": "along the item in the off hand"},
    "body":  {"y0": 0.22, "y1": 1.95, "r": 0.62, "shape": "helix", "label": "the whole body (sets)"},
    "aura":  {"y0": 0.22, "y1": 2.10, "r": 0.70, "shape": "combo", "label": "around everything (combinations)"}
  },

  "tiers": {
    "about": "Level / max level. One-level enchantments (Mending, Infinity, Flame…) are max. Above the vanilla maximum: overcharged.",
    "hint":        {"upTo": 0.40, "rate": 0.5, "size": 0.85, "flourish": false},
    "clear":       {"upTo": 0.99, "rate": 1.0, "size": 1.0,  "flourish": false},
    "max":         {"upTo": 1.00, "rate": 1.4, "size": 1.1,  "flourish": true},
    "overcharged": {"above": 1.00, "rate": 2.0, "size": 1.25, "flourish": true, "shift": true}
  },

  "motions": {
    "still":    "no speed; the particle's own drift",
    "rise":     "up, 0.03 a tick",
    "fall":     "down, 0.03 a tick",
    "float":    "a little in any direction",
    "sink":     "slowly down, 0.015 a tick",
    "pop":      "a hop up and out, then down (gravity)",
    "sway":     "slowly down, swaying sideways",
    "tangent":  "along the ring (swirl), 0.05 a tick",
    "outward":  "away from the body, 0.08 a tick",
    "approach": "flies in from a little way out and settles on the point (enchanting glyphs, nautilus, portal)"
  },

  "shapes": {
    "ring":      "points evenly round a circle that slowly turns",
    "helix":     "two strands winding up the body",
    "spiral":    "one strand winding up",
    "column":    "straight up from a point",
    "ribs":      "vertical lines at fixed places round the body",
    "square":    "a square instead of a circle",
    "zigzag":    "a jagged line up",
    "pulse":     "a ring that grows and shrinks",
    "sentinels": "four points standing still at north, east, south and west",
    "arc":       "a sweep in front of you, drawn over a few ticks",
    "burst":     "out (or in) from one point all at once",
    "trail":     "a streak from one point to another (the trail particle)",
    "footprint": "where a foot touches the ground, per step",
    "anchor":    "along the held item: the blade, the bow string, the tool head",
    "wingtips":  "from the tips of the elytra while gliding"
  },

  "families": {
    "fire":       {"name": "Flames", "enchants": ["fire_aspect", "flame"], "motif": {"p": "flame", "motion": "rise"}, "flourish": {"p": "lava", "motion": "pop", "share": 0.25},
                   "events": {"swing": {"shape": "arc", "p": "flame"}, "kill": {"shape": "burst", "p": "flame", "n": 10}, "shoot": {"shape": "trail", "p": "flame"}}},
    "lightning":  {"name": "Lightning", "enchants": ["channeling"], "motif": {"p": "electric_spark", "motion": "float"}, "flourish": {"p": "flash", "color": "#CFE8FF", "share": 0.05},
                   "events": {"shoot": {"shape": "trail", "p": "electric_spark"}, "swing": {"shape": "arc", "p": "electric_spark"}}},
    "frost":      {"name": "Frost", "enchants": ["frost_walker"], "motif": {"p": "snowflake", "motion": "fall"}, "flourish": {"p": "dust", "color": "#DFF4FF", "share": 0.3},
                   "events": {"step": {"shape": "footprint", "p": "snowflake", "n": 3}}},
    "soul":       {"name": "Soul fire", "enchants": ["soul_speed"], "motif": {"p": "soul_fire_flame", "motion": "rise"}, "flourish": {"p": "soul", "motion": "rise", "share": 0.25},
                   "events": {"step": {"shape": "footprint", "p": "soul_fire_flame", "n": 2, "onlyOn": "soul blocks"}}},
    "holy":       {"name": "Holy light", "enchants": ["smite"], "motif": {"p": "end_rod", "motion": "float"}, "flourish": {"p": "dust", "color": "#FFD45A", "share": 0.3},
                   "events": {"swing": {"shape": "arc", "p": "end_rod"}, "hit": {"shape": "burst", "p": "flash", "color": "#FFF2B0", "onlyAgainst": "undead"}}},
    "poison":     {"name": "Venom", "enchants": ["bane_of_arthropods"], "motif": {"p": "dust", "color": "#7CC24A", "motion": "fall"}, "flourish": {"p": "item_slime", "share": 0.2},
                   "events": {"swing": {"shape": "arc", "p": "dust", "color": "#7CC24A"}, "hit": {"shape": "burst", "p": "noxious_gas", "onlyAgainst": "arthropods"}}},
    "tide":       {"name": "Waves", "enchants": ["riptide"], "motif": {"p": "dripping_water", "motion": "fall"}, "flourish": {"p": "splash", "share": 0.3},
                   "events": {"riptide": {"shape": "spiral", "p": "splash", "n": 16}}},
    "water":      {"name": "Bubbles", "enchants": ["aqua_affinity", "depth_strider", "respiration"], "motif": {"p": "dripping_water", "motion": "fall", "underwater": "bubble"}, "flourish": {"p": "bubble_pop", "share": 0.3},
                   "events": {"underwater": {"shape": "column", "p": "bubble", "n": 2}}},
    "sculk":      {"name": "Sculk", "enchants": ["swift_sneak"], "motif": {"p": "sculk_soul", "motion": "rise"}, "flourish": {"p": "sculk_charge_pop", "share": 0.3},
                   "events": {"sneak": {"shape": "ribs", "p": "sculk_soul", "n": 2}}},
    "blast":      {"name": "Smoke", "enchants": ["blast_protection"], "motif": {"p": "smoke", "motion": "rise"}, "flourish": {"p": "poof", "share": 0.2},
                   "events": {"hit": {"shape": "burst", "p": "poof", "n": 12, "onlyFrom": "explosions"}}},
    "sweep":      {"name": "Sweeping arc", "enchants": ["sweeping_edge"], "motif": {"p": "cloud", "motion": "float", "size": 0.5}, "flourish": {"p": "sweep_attack", "share": 0.05},
                   "events": {"swing": {"shape": "arc", "p": "sweep_attack", "n": 3}}},
    "feather":    {"name": "Feathers", "enchants": ["feather_falling"], "motif": {"p": "white_ash", "motion": "sway"}, "flourish": {"p": "cloud", "size": 0.4, "share": 0.2},
                   "events": {"fall": {"shape": "spiral", "p": "white_ash", "n": 2}, "land": {"shape": "burst", "p": "poof", "n": 10, "flat": true}}},
    "loyalty":    {"name": "Returning light", "enchants": ["loyalty"], "motif": {"p": "glow", "motion": "float"}, "flourish": {"p": "end_rod", "share": 0.2},
                   "events": {"shoot": {"shape": "trail", "p": "glow"}}},
    "sharp":      {"name": "Edge", "enchants": ["sharpness", "piercing"], "motif": {"p": "crit", "motion": "still"}, "flourish": {"p": "enchanted_hit", "share": 0.3},
                   "events": {"swing": {"shape": "arc", "p": "crit"}, "shoot": {"shape": "trail", "p": "crit"}}},
    "impale":     {"name": "Sea shine", "enchants": ["impaling"], "motif": {"p": "nautilus", "motion": "approach"}, "flourish": {"p": "glow", "share": 0.2},
                   "events": {"shoot": {"shape": "trail", "p": "nautilus"}}},
    "heavy":      {"name": "Gravity", "enchants": ["density"], "motif": {"p": "reverse_portal", "motion": "sink"}, "flourish": {"p": "portal", "share": 0.3},
                   "events": {"smash": {"shape": "burst", "p": "reverse_portal", "n": 24, "flat": true}}},
    "breach":     {"name": "Cracks", "enchants": ["breach"], "motif": {"p": "lava", "motion": "pop", "rate": 0.4}, "flourish": {"p": "crit", "share": 0.3},
                   "events": {"hit": {"shape": "burst", "p": "crit", "n": 8}}},
    "power":      {"name": "Power", "enchants": ["power"], "motif": {"p": "enchanted_hit", "motion": "still"}, "flourish": {"p": "end_rod", "share": 0.15},
                   "events": {"shoot": {"shape": "trail", "p": "enchanted_hit"}}},
    "multishot":  {"name": "Triple", "enchants": ["multishot"], "motif": {"p": "firework", "motion": "float"}, "flourish": {"p": "firework", "share": 0.3},
                   "events": {"shoot": {"shape": "trail", "p": "firework"}}},
    "haste":      {"name": "Speed", "enchants": ["efficiency", "quick_charge"], "motif": {"p": "wax_off", "motion": "float"}, "flourish": {"p": "electric_spark", "share": 0.2},
                   "events": {"break": {"shape": "burst", "p": "wax_off", "n": 6}}},
    "wind":       {"name": "Wind", "enchants": ["knockback", "punch", "wind_burst", "lunge"], "motif": {"p": "small_gust", "motion": "still", "rate": 0.5}, "flourish": {"p": "cloud", "size": 0.5, "share": 0.3},
                   "events": {"hit": {"shape": "burst", "p": "small_gust", "n": 3}, "smash": {"shape": "burst", "p": "gust", "n": 1}}},
    "infinity":   {"name": "Stars", "enchants": ["infinity"], "motif": {"p": "witch", "motion": "rise"}, "flourish": {"p": "end_rod", "share": 0.2},
                   "events": {"shoot": {"shape": "trail", "p": "witch"}}},
    "thorns":     {"name": "Thorns", "enchants": ["thorns"], "motif": {"p": "dust", "color": "#B5121B", "motion": "still"}, "flourish": {"p": "damage_indicator", "share": 0.1},
                   "events": {"hurt": {"shape": "trail", "p": "trail", "color": "#D4202B", "n": 5, "toward": "attacker"}}},
    "fireguard":  {"name": "Fire guard", "enchants": ["fire_protection"], "motif": {"p": "small_flame", "motion": "rise"}, "flourish": {"p": "dust", "color": "#FF8A2B", "share": 0.3},
                   "events": {"burning": {"shape": "ring", "p": "flame", "n": 6}}},
    "arrowguard": {"name": "Arrow guard", "enchants": ["projectile_protection"], "motif": {"p": "crit", "motion": "still"}, "flourish": {"p": "dust", "color": "#C9D3DE", "share": 0.3},
                   "events": {"hurt": {"shape": "ring", "p": "crit", "n": 10, "onlyFrom": "projectiles"}}},
    "protection": {"name": "Shield", "enchants": ["protection"], "accentOnly": true, "motif": {"p": "enchant", "motion": "approach"}, "flourish": {"p": "dust", "color": "#7FE8FF", "share": 0.3},
                   "events": {"hurt": {"shape": "burst", "p": "enchant", "n": 14, "inward": true, "ripple": {"p": "trail", "color": "#7FE8FF", "n": 8}}}},
    "silk":       {"name": "Silk", "enchants": ["silk_touch"], "motif": {"p": "cherry_leaves", "motion": "sway"}, "flourish": {"p": "dust", "color": "#F4B6D2", "share": 0.2},
                   "events": {"break": {"shape": "burst", "p": "cherry_leaves", "n": 5}}},
    "sturdy":     {"name": "Steel sheen", "enchants": ["unbreaking"], "silent": true},
    "curse":      {"name": "Curse", "enchants": ["binding_curse", "vanishing_curse"], "accentOnly": true, "motif": {"p": "squid_ink", "motion": "fall", "size": 0.5}},
    "luck":       {"name": "Lucky stars", "enchants": ["fortune", "looting"], "motif": {"p": "happy_villager", "motion": "float"}, "flourish": {"p": "dust", "color": "#3BD16F", "share": 0.3},
                   "events": {"kill": {"shape": "burst", "p": "happy_villager", "n": 6}, "break": {"shape": "burst", "p": "happy_villager", "n": 4, "onlyOn": "ores"}}},
    "sea":        {"name": "Sea foam", "enchants": ["luck_of_the_sea", "lure"], "motif": {"p": "bubble_pop", "motion": "still"}, "flourish": {"p": "splash", "share": 0.3},
                   "events": {"catch": {"shape": "burst", "p": "splash", "n": 10}}},
    "mending":    {"name": "Experience", "enchants": ["mending"], "silent": true,
                   "events": {"repair": {"shape": "burst", "p": "happy_villager", "n": 4, "at": "item"}}}
  },

  "order": ["fire", "soul", "lightning", "frost", "holy", "sculk", "tide", "water", "poison", "loyalty", "impale", "heavy", "breach", "infinity", "power",
            "multishot", "sweep", "feather", "blast", "fireguard", "thorns", "arrowguard", "wind", "haste", "sharp", "silk", "luck", "sea", "protection", "curse", "mending", "sturdy"],

  "materials": {
    "leather":   {"name": "Leather",   "color": "dye", "default": "#A06540", "character": {"speed": 0.8, "size": 1.0},
                  "set": {"name": "Wanderer", "shape": "footprint", "p": "dust", "color": "dye", "when": "walking"}},
    "chainmail": {"name": "Chainmail", "color": "#A9AFB5", "character": {"speed": 1.0, "size": 0.85},
